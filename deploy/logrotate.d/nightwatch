/var/log/suricata/eve.json {
    daily
    rotate 7
    compress
    missingok
    notifempty
    copytruncate
    su root adm
    create 0640 root adm
}

# 故意用 .json 后缀，避开 nginx 包 /var/log/nginx/*.log 的 rename 轮转；
# ModSecurity 不会在 rename 后重开文件，copytruncate 才能持续写入。
/var/log/nginx/modsec_audit.json {
    daily
    rotate 7
    compress
    missingok
    notifempty
    copytruncate
    su www-data adm
    create 0640 www-data adm
}

/var/log/nginx/nw_access.log {
    daily
    rotate 7
    compress
    missingok
    notifempty
    create 0640 www-data adm
    postrotate
        [ -f /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)" || true
    endscript
}

[Unit]
Description=AI Nightwatch - guard & dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=li
Group=li
WorkingDirectory=/home/li/nightwatch
ExecStart=/home/li/nightwatch/.venv/bin/python -m app.main
EnvironmentFile=-/home/li/nightwatch/data/agent.env
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/li/nightwatch/data /home/li/nightwatch/logs /home/li/nightwatch/osv
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

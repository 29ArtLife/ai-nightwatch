[Unit]
Description=AI Nightwatch - guard & dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=li
Group=li
WorkingDirectory=/home/li/nightwatch
ExecStart=/home/li/nightwatch/.venv/bin/python -m app.cli daemon
EnvironmentFile=-/home/li/nightwatch/data/agent.env
Restart=always
RestartSec=3
# 需要 sudo -n 调 /usr/local/sbin/nw-fw；sudo 面只授权固定 wrapper
NoNewPrivileges=false
SupplementaryGroups=adm
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/li/nightwatch/data /home/li/nightwatch/logs /home/li/nightwatch/osv
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
